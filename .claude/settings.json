{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git blame:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(hpc-session:*)",
      "Bash(sbatch:*)",
      "Bash(squeue:*)",
      "Bash(sacct:*)",
      "Bash(sacctmgr:*)",
      "Bash(scancel:*)",
      "Bash(scontrol:*)",
      "Bash(sinfo:*)",
      "Bash(srun:*)",
      "Bash(salloc:*)",
      "Bash(sattach:*)",
      "Bash(sprio:*)",
      "Bash(sshare:*)",
      "Bash(sreport:*)",
      "Bash(module:*)",
      "Read(./secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/*totp*)",
      "Read(**/*.pem)"
    ]
  }
}
