# Local image built by Docker Compose.
MOCK_SLURM_IMAGE=mock-slurm-cluster:25-11-2-1

# SchedMD git tag compiled into the image.
SLURM_TAG=slurm-25-11-2-1

# Pinned Codex CLI installed inside the login image.
CODEX_VERSION=0.146.0

# Default model for manual and headless benchmark agents.
CODEX_MODEL=gpt-5.6-terra

# Keep the initial source build from saturating a laptop.
BUILD_JOBS=2

# Loopback port used for the demo_user SSH service.
SSH_PORT=2223
