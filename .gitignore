# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/

# uv.lock IS committed (benchmark/uv.lock) — benchmark results must be attributable to an exact
# environment.

# Episode sandboxes and simulator state — regenerated, never committed
sandboxes/
*.sqlite
*.sqlite3

# Benchmark outputs: append-only per run, kept out of git.
# Commit only the aggregated summaries a PR explicitly discusses.
results/**
!results/README.md

# Local agent working notes (specs, plans). Not project deliverables —
# see docs/benchmark-methodology.md for the reviewed methodology.
docs/superpowers/

# Personal agent overrides
.claude/settings.local.json

# Local preview build of the Pages site (the workflow builds this in CI)
_site/

# OS
.DS_Store

# MyST build output. `benchmark/_build/` is a 26 MB static site plus a template cache,
# regenerated by `myst build --html` from benchmark/*.md + benchmark/results/. The inputs
# are tracked; the render is not.
benchmark/_build/
# A build input, created by the workflow (and locally by hand) so figure artifacts referenced
# from pages/ resolve against benchmark/results/. Not created by `myst build` — do not rely on
# that. Left uncommitted so the tree does not depend on one renderer's asset resolution.
benchmark/pages/results
benchmark/pages/cases/results
